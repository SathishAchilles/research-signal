# App runtime connection as rs_app through the Supabase transaction pooler (port 6543)
DATABASE_URL=
# rs_app through the Supabase session pooler (port 5432), used by scripts/migrate.ts
DATABASE_MIGRATION_URL=
# postgres role session-pooler URL, used only for one-time bootstrap SQL (optional)
DATABASE_ADMIN_URL=
# OpenRouter API key (sk-or-v1-...), all LLM and embedding calls go through it
OPENROUTER_API_KEY=
# Resend send-only API key for the weekly brief email
RESEND_API_KEY=
# Sender identity for Resend, e.g. "research-signal <onboarding@resend.dev>"
RESEND_FROM=
# Secret for signing session cookies (openssl rand -base64 32)
SESSION_SECRET=
# Secret for signing one-click email action links (openssl rand -base64 32)
ACTION_LINK_SECRET=
# Bearer secret that pg_cron and Vercel Cron send to /api/stage/* (openssl rand -hex 32)
CRON_SECRET=
# Public base URL of the deployment (defaults to https://research-signal.vercel.app)
APP_URL=
# Contact address used in source API User-Agent headers (defaults to sathshh@gmail.com)
CONTACT_EMAIL=
# Hugging Face token for the papers API (optional)
HF_TOKEN=
# CORE API key for full-text lookup (optional, CORE is off by default)
CORE_API_KEY=
